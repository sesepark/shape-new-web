DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/shape?ssl=require
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
COOKIE_DOMAIN=
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INITIAL_OWNER_EMAILS=owner@example.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@snu-shape.com
# 관리자가 저장하면 공개 페이지를 즉시 새로 고치기 위한 값. Vercel 쪽과 같은 값을 넣습니다.
REVALIDATE_SECRET=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300
PUBLIC_CACHE_SECONDS=300
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=20
MAX_REQUEST_BYTES=2000000
